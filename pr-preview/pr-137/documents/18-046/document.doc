&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; {% elif output.data_type|lower == "boundingbox" %}<br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; <span class="c">&lt;!-- wps:BoundingBox TO BE IMPLEMENTED --&gt;</span><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; {% endif %}<br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; <span class="nt">&lt;/wps:Output&gt;</span><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; {% endfor %}<br/><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; <span class="nt">&lt;/wps:Process&gt;</span><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; <span class="nt">&lt;/wps:ProcessOffering&gt;</span><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; <span class="nt">&lt;/owc:content&gt;</span><br/>&#xA0;&#xA0;&#xA0; <span class="nt">&lt;/owc:offering&gt;</span><br/><br/>&#xA0;&#xA0;&#xA0; <span class="nt">&lt;category</span> <span class="na">scheme=</span><span class="s">"http://www.opengis.net/tb13/eoc/os"</span> <span class="na">term=</span><span class="s">"LINUX"</span> <span class="na">label=</span><span class="s">"This app runs in Linux"</span><span class="nt">/&gt;</span><br/><br/>&#xA0; <span class="nt">&lt;/entry&gt;</span><br/>&#xA0; {% endfor %}<br/><br/>&#xA0; {% for cat in ap.catalogues %}<br/>&#xA0; <span class="nt">&lt;entry&gt;</span><br/>&#xA0;&#xA0;&#xA0; <span class="nt">&lt;id&gt;</span>{{ cat.id }}<span class="nt">&lt;/id&gt;</span><br/>&#xA0;&#xA0;&#xA0; <span class="nt">&lt;link</span> <span class="na">rel=</span><span class="s">"profile"</span> <span class="na">href=</span><span class="s">"http://www.opengis.net/tb13/eoc/catalogue"</span><br/>&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0;&#xA0; <span class="na">title=</span><span class="s">"This entry contains an catalogue as specified by Testbed-13 EOC Thread"</span><span class="nt">/&gt;</span><br/>&#xA0; <span class="nt">&lt;/entry&gt;</span><b