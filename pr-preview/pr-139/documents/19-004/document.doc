Pr></m:ctrlPr></m:funcPr><m:fName><m:r><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts></w:rPr><m:t>sin</m:t></m:r></m:fName><m:e><m:r><m:t>&#x3B3;</m:t></m:r></m:e></m:func></m:e></m:mr><m:mr><m:e><m:r><m:t>&#x2212;</m:t></m:r><m:r><m:t></m:t></m:r><m:func><m:funcPr><m:ctrlPr><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts><w:i></w:i></w:rPr></m:ctrlPr></m:funcPr><m:fName><m:r><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts></w:rPr><m:t>sin</m:t></m:r></m:fName><m:e><m:r><m:t>&#x3B2;</m:t></m:r></m:e></m:func></m:e><m:e><m:r><m:t></m:t></m:r><m:func><m:funcPr><m:ctrlPr><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts><w:i></w:i></w:rPr></m:ctrlPr></m:funcPr><m:fName><m:r><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts></w:rPr><m:t>cos</m:t></m:r></m:fName><m:e><m:r><m:t>&#x3B2;</m:t></m:r></m:e></m:func><m:r><m:t></m:t></m:r><m:func><m:funcPr><m:ctrlPr><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts><w:i></w:i></w:rPr></m:ctrlPr></m:funcPr><m:fName><m:r><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts></w:rPr><m:t>sin</m:t></m:r></m:fName><m:e><m:r><m:t>&#x3B3;</m:t></m:r></m:e></m:func></m:e><m:e><m:r><m:t></m:t></m:r><m:func><m:funcPr><m:ctrlPr><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts><w:i></w:i></w:rPr></m:ctrlPr></m:funcPr><m:fName><m:r><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts></w:rPr><m:t>cos</m:t></m:r></m:fName><m:e><m:r><m:t>&#x3B2;</m:t></m:r></m:e></m:func><m:r><m:t></m:t></m:r><m:func><m:funcPr><m:ctrlPr><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts><w:i></w:i></w:rPr></m:ctrlPr></m:funcPr><m:fName><m:r><w:rPr><w:rFonts w:ascii="Cambria Math" w:hAnsi="Cambria Math"></w:rFonts></w:rPr><m:t>cos</m:t></m:r></m:fName><m:e><m:r><m:t>&#x3B3;</m:t></m:r></m:e></m:func></m:e></m:mr></m:m></m:e></m:d>
