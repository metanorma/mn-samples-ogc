<div class="ul_wrap"><p style="mso-list:l3 level1 lfo59;" class="MsoListParagraphCxSpFirst"><a name="_4e2e1deb-0398-043c-4a70-5f3abfed0e66" id="_4e2e1deb-0398-043c-4a70-5f3abfed0e66"></a><b>Type</b>: <tt>object, number[3]</tt>
